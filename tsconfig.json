{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "allowJs": true,
    "checkJs": true,
    "paths": {
      "@4ol/api": [
        "./packages/api"
      ],
      "@4ol/api/*": [
        "./packages/api/*"
      ],
      "@4ol/email-sender/*": [
        "./packages/email-sender/*"
      ],
      "@4ol/db": [
        "./packages/db"
      ],
      "@4ol/db/schemas/*": [
        "./packages/db/schemas/*"
      ],
      "@4ol/db/models/*": [
        "./packages/db/models/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist"
  ],
  "extends": "expo/tsconfig.base"
}
