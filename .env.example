# ===================================
# PRODUCTION ENVIRONMENT VARIABLES
# ===================================
# Copy this to Vercel Dashboard → Settings → Environment Variables

# ===================================
# DATABASE (Required - Neon PostgreSQL)
# ===================================
# Get these from: https://console.neon.tech
# Regular connection for queries/reads
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require

# Pooled connection for writes/transactions (add '-pooler' to endpoint)
DATABASE_POOLER_URL=postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/dbname?sslmode=require

# ===================================
# BETTER AUTH (Required)
# ===================================
# Generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=your-random-32-character-secret-here

# Your production domain (update after deployment)
BETTER_AUTH_URL=https://your-app.vercel.app

# ===================================
# OBJECT STORAGE (Required - OCI/S3)
# ===================================
# Get these from Oracle Cloud Infrastructure or AWS S3
OCI_BUCKET_NAME=your-bucket-name
OCI_ENDPOINT=https://your-namespace.compat.objectstorage.us-phoenix-1.oraclecloud.com
OCI_ACCESS_KEY_ID=your-access-key-id
OCI_SECRET_ACCESS_KEY=your-secret-access-key
OCI_REGION=us-phoenix-1

# CDN URL for optimized image delivery
IMAGE_BASE_URL=https://your-cdn-domain.com

# ===================================
# NODE ENVIRONMENT (Required)
# ===================================
NODE_ENV=production

# ===================================
# OPTIONAL - Performance & Monitoring
# ===================================
# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1

# ===================================
# DEVELOPMENT ONLY (Do NOT set in Vercel)
# ===================================
# These are for local development only
# BETTER_AUTH_URL=http://localhost:3000
# NODE_ENV=development

# ===================================
# NOTES
# ===================================
# 1. Never commit .env.local with real values to git
# 2. Add all variables to Vercel Dashboard for all environments:
#    - Production
#    - Preview
#    - Development
# 3. Redeploy after adding/changing environment variables
# 4. Test with preview deployment before promoting to production
