create table public.condition_body_parts (
  condition_id uuid not null,
  body_part_id uuid not null,
  constraint condition_body_parts_body_part_id_condition_id_pk primary key (body_part_id, condition_id),
  constraint condition_body_parts_body_part_id_body_parts_id_fk foreign KEY (body_part_id) references body_parts (id),
  constraint condition_body_parts_condition_id_conditions_id_fk foreign KEY (condition_id) references conditions (id) on delete CASCADE
) TABLESPACE pg_default;

create index IF not exists condition_lookup_idx on public.condition_body_parts using btree (condition_id) TABLESPACE pg_default;

---

create table public.condition_categories (
  condition_id uuid not null,
  category_id uuid not null,
  constraint condition_categories_category_id_condition_id_pk primary key (category_id, condition_id),
  constraint condition_categories_category_id_categories_id_fk foreign KEY (category_id) references categories (id),
  constraint condition_categories_condition_id_conditions_id_fk foreign KEY (condition_id) references conditions (id) on delete CASCADE
) TABLESPACE pg_default;

---

create table public.conditions (
  id uuid not null default gen_random_uuid (),
  name text null,
  slug text null,
  nhs_link text null,
  image_url text null,
  about jsonb null,
  diagnosis jsonb null,
  treatment jsonb null,
  complications jsonb null,
  symptoms jsonb null,
  prevention jsonb null,
  contact_your_doctor jsonb null,
  more_information jsonb null,
  attribution jsonb null,
  is_systemic boolean null default false,
  search_vector tsvector null,
  specialist text null,
  created_at timestamp without time zone not null default now(),
  updated_at timestamp without time zone not null default now(),
  status text null default 'published'::text,
  is_featured boolean null default false,
  featured_order integer null default 0,
  featured_from timestamp with time zone null,
  featured_until timestamp with time zone null,
  view_count integer null default 0,
  author_id uuid null,
  reviewed_by uuid null,
  reviewed_at timestamp with time zone null,
  is_pinned boolean null default false,
  metadata jsonb null default '{}'::jsonb,
  constraint conditions_pkey primary key (id),
  constraint conditions_author_id_fkey foreign KEY (author_id) references user_profiles (user_id) on delete set null,
  constraint conditions_reviewed_by_fkey foreign KEY (reviewed_by) references user_profiles (user_id) on delete set null,
  constraint chk_condition_status check (
    (
      status = any (
        array[
          'draft'::text,
          'published'::text,
          'archived'::text,
          'pending_review'::text
        ]
      )
    )
  )
) TABLESPACE pg_default;

create unique INDEX IF not exists idx_conditions_slug on public.conditions using btree (slug) TABLESPACE pg_default;

create index IF not exists idx_conditions_name_trgm on public.conditions using gin (name gin_trgm_ops) TABLESPACE pg_default;

create index IF not exists condition_name_idx on public.conditions using btree (name) TABLESPACE pg_default;

create trigger trg_log_conditions_change
after INSERT
or DELETE
or
update on conditions for EACH row
execute FUNCTION fn_log_admin_activity ();

[{"idx":1,"id":"079523e1-6903-4402-9382-1e17e3df9d2f","name":"Hypoglycaemia (low blood sugar)","slug":"hypoglycaemia-(low-blood-sugar)","nhs_link":"","image_url":"conditions/hypoglycaemia(lowbloodsugar)-GnsA7Teb/905Q-Hypoglycaemia_(low_blood_sugar).png","about":"{\"root\": {\"type\": \"root\", \"format\": \"\", \"indent\": 0, \"version\": 1, \"children\": [{\"type\": \"paragraph\", \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"Hypoglycaemia, or a “hypo”, is an abnormally low level of glucose in your blood (less than four millimoles per litre).\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null, \"textStyle\": \"\", \"textFormat\": 0}, {\"type\": \"paragraph\", \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"When your glucose (sugar) level is too low, your body doesn’t have enough energy to carry out its activities.\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null, \"textStyle\": \"\", \"textFormat\": 0}, {\"type\": \"paragraph\", \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"Hypoglycaemia is most commonly associated with diabetes, and mainly occurs if someone with diabetes takes too much insulin, misses a meal or exercises too hard.\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null, \"textStyle\": \"\", \"textFormat\": 0}, {\"type\": \"paragraph\", \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"In rare cases, it’s possible for a person who doesn’t have diabetes to experience hypoglycaemia. It can be triggered by malnutrition, binge drinking or certain conditions, such as Addison’s disease.\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null, \"textStyle\": \"\", \"textFormat\": 0}], \"direction\": null}}","diagnosis":"{\"root\": {\"type\": \"root\", \"format\": \"\", \"indent\": 0, \"version\": 1, \"children\": [{\"type\": \"paragraph\", \"format\": \"\", \"indent\": 0, \"version\": 1, \"children\": [], \"direction\": null, \"textStyle\": \"\", \"textFormat\": 0}], \"direction\": null}}","treatment":"{\"root\": {\"type\": \"root\", \"format\": \"\", \"indent\": 0, \"version\": 1, \"children\": [{\"tag\": \"h2\", \"type\": \"heading\", \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"Treating hypoglycaemia\", \"type\": \"text\", \"style\": \"font-size: 18px;\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null}, {\"type\": \"paragraph\", \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"In most cases, you can treat hypoglycaemia yourself when you recognise the symptoms.\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null, \"textStyle\": \"\", \"textFormat\": 0}, {\"tag\": \"h2\", \"type\": \"heading\", \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"Treating an episode of hypoglycaemia\", \"type\": \"text\", \"style\": \"font-size: 17px;\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null}, {\"type\": \"paragraph\", \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"The immediate treatment for hypoglycaemia is to have some sugary food or drink (about 15 to 20g of rapidly acting carbohydrate) to end the attack.\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null, \"textStyle\": \"\", \"textFormat\": 0}, {\"type\": \"paragraph\", \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"For example, this could be:\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null, \"textStyle\": \"\", \"textFormat\": 0}, {\"tag\": \"ul\", \"type\": \"list\", \"start\": 1, \"format\": \"\", \"indent\": 0, \"version\": 1, \"children\": [{\"type\": \"listitem\", \"value\": 1, \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"a glass of fruit juice or non-diet soft drink\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null}, {\"type\": \"listitem\", \"value\": 2, \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"between three and five dextrose tablets\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null}, {\"type\": \"listitem\", \"value\": 3, \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"a handful of sweets\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null}], \"listType\": \"bullet\", \"direction\": null}, {\"type\": \"paragraph\", \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"At first you should avoid fatty foods and drinks, such as chocolate and milk, because they don’t usually contain as much sugar and the sugar they do contain may be absorbed more slowly.\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null, \"textStyle\": \"\", \"textFormat\": 0}, {\"type\": \"paragraph\", \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"After having something sugary, you should have a longer-acting carbohydrate food, such as a few biscuits, a cereal bar, a piece of fruit or a sandwich.\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null, \"textStyle\": \"\", \"textFormat\": 0}, {\"type\": \"paragraph\", \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"It will usually take around 15 minutes to recover from a mild episode of hypoglycaemia. If you have a blood glucose meter, measure your blood sugar again after 15 to 20 minutes. If it’s still too low (below 4mmol), you should have some more sugary food or a drink before testing your levels again in another 15 to 20 minutes.\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null, \"textStyle\": \"\", \"textFormat\": 0}, {\"type\": \"paragraph\", \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"When treating someone else with hypoglycaemia, if the above treatment isn’t effective, you may be able to help them by applying glucose gel (or honey, treacle or jam if glucose gel isn’t available) to the inside of their cheeks, and gently massaging the outside of their cheeks.\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null, \"textStyle\": \"\", \"textFormat\": 0}, {\"type\": \"paragraph\", \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"It may take 10 to 15 minutes before they feel better. This shouldn’t be done if the person is drowsy or unconscious because of the risk of choking.\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null, \"textStyle\": \"\", \"textFormat\": 0}, {\"type\": \"paragraph\", \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"If you have several episodes of hypoglycaemia a week, you should contact your diabetes care team to find out the underlying cause. Your medication may need to be adjusted, or there may be another condition causing hypoglycaemia that needs to be treated.\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null, \"textStyle\": \"\", \"textFormat\": 0}, {\"tag\": \"h2\", \"type\": \"heading\", \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"If a person is unconscious\", \"type\": \"text\", \"style\": \"font-size: 17px;\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null}, {\"type\": \"paragraph\", \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"If a person loses consciousness because of severe hypoglycaemia, they need to be put into the recovery position and given an injection of the hormone glucagon (if they have an injection kit). The injection will raise their blood glucose level.\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null, \"textStyle\": \"\", \"textFormat\": 0}, {\"type\": \"paragraph\", \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"The injection should be carried out by a friend or family member who knows what they’re doing, or by a trained healthcare professional.\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null, \"textStyle\": \"\", \"textFormat\": 0}, {\"type\": \"paragraph\", \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"You should dial 999 to request an ambulance if:\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null, \"textStyle\": \"\", \"textFormat\": 0}, {\"tag\": \"ul\", \"type\": \"list\", \"start\": 1, \"format\": \"\", \"indent\": 0, \"version\": 1, \"children\": [{\"type\": \"listitem\", \"value\": 1, \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"a glucagon injection kit isn’t available\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null}, {\"type\": \"listitem\", \"value\": 2, \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"there’s nobody available who’s trained to give the injection\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null}, {\"type\": \"listitem\", \"value\": 3, \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"the injection is ineffective after 10 minutes\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null}], \"listType\": \"bullet\", \"direction\": null}, {\"type\": \"paragraph\", \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"Never try to put food or drink into the mouth of someone who’s unconscious as they could choke.\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null, \"textStyle\": \"\", \"textFormat\": 0}, {\"type\": \"paragraph\", \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"If you’re able to give a glucagon injection and the person regains consciousness, they should eat some longer-acting carbohydrate food, such as a few biscuits, a cereal bar or a sandwich.\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null, \"textStyle\": \"\", \"textFormat\": 0}, {\"type\": \"paragraph\", \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"You should continue to monitor the person for signs of recurring symptoms in case they need to be treated again.\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null, \"textStyle\": \"\", \"textFormat\": 0}], \"direction\": null}}","complications":"{\"root\": {\"type\": \"root\", \"format\": \"\", \"indent\": 0, \"version\": 1, \"children\": [{\"type\": \"paragraph\", \"format\": \"\", \"indent\": 0, \"version\": 1, \"children\": [], \"direction\": null, \"textStyle\": \"\", \"textFormat\": 0}], \"direction\": null}}","symptoms":"{\"root\": {\"type\": \"root\", \"format\": \"\", \"indent\": 0, \"version\": 1, \"children\": [{\"tag\": \"h2\", \"type\": \"heading\", \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"Symptoms of hypoglycaemia\", \"type\": \"text\", \"style\": \"font-size: 18px;\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null}, {\"type\": \"paragraph\", \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"The symptoms of hypoglycaemia usually begin when your blood glucose level drops below four millimoles (mmol) per litre.\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null, \"textStyle\": \"\", \"textFormat\": 0}, {\"type\": \"paragraph\", \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"If you have diabetes, particularly if it’s treated with insulin, you may be advised to use a small device called a blood glucose meter to regularly check your blood glucose levels.\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null, \"textStyle\": \"\", \"textFormat\": 0}, {\"type\": \"paragraph\", \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"Symptoms can vary from person to person, and it’s important to be aware of the early warning signs so you can treat them.\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null, \"textStyle\": \"\", \"textFormat\": 0}, {\"type\": \"paragraph\", \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"Signs and symptoms of hypoglycaemia can include:\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null, \"textStyle\": \"\", \"textFormat\": 0}, {\"tag\": \"ul\", \"type\": \"list\", \"start\": 1, \"format\": \"\", \"indent\": 0, \"version\": 1, \"children\": [{\"type\": \"listitem\", \"value\": 1, \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"feeling hungry\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null}, {\"type\": \"listitem\", \"value\": 2, \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"sweating\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null}, {\"type\": \"listitem\", \"value\": 3, \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"dizziness\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null}, {\"type\": \"listitem\", \"value\": 4, \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"tiredness (fatigue)\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null}, {\"type\": \"listitem\", \"value\": 5, \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"blurred vision\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null}, {\"type\": \"listitem\", \"value\": 6, \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"trembling or shakiness\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null}, {\"type\": \"listitem\", \"value\": 7, \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"going pale\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null}, {\"type\": \"listitem\", \"value\": 8, \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"fast pulse or palpitations\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null}, {\"type\": \"listitem\", \"value\": 9, \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"tingling lips\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null}, {\"type\": \"listitem\", \"value\": 10, \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"irritability\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null}, {\"type\": \"listitem\", \"value\": 11, \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"difficulty concentrating\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null}, {\"type\": \"listitem\", \"value\": 12, \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"confusion\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null}, {\"type\": \"listitem\", \"value\": 13, \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"disorderly or irrational behaviour, which may be mistaken for drunkenness\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null}], \"listType\": \"bullet\", \"direction\": null}, {\"type\": \"paragraph\", \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"If hypoglycaemia isn’t treated promptly and your blood glucose levels drop low enough, you may become drowsy or even lose consciousness.\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null, \"textStyle\": \"\", \"textFormat\": 0}, {\"type\": \"paragraph\", \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"Most people with insulin-treated diabetes notice that the symptoms of hypoglycaemia change and become less obvious the longer they live with the condition.\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null, \"textStyle\": \"\", \"textFormat\": 0}, {\"type\": \"paragraph\", \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"For some people, the warning symptoms become greatly reduced, putting them at significant risk of having severe episodes where they’re dependent on others for help.\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null, \"textStyle\": \"\", \"textFormat\": 0}, {\"type\": \"paragraph\", \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"Let your diabetes care team know if you develop this problem as your treatment may need to be changed to reduce the risk.\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null, \"textStyle\": \"\", \"textFormat\": 0}, {\"type\": \"paragraph\", \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"Read more about how hypoglycaemia is treated\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null, \"textStyle\": \"\", \"textFormat\": 0}, {\"tag\": \"h2\", \"type\": \"heading\", \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"Hypoglycaemia while sleeping\", \"type\": \"text\", \"style\": \"font-size: 17px;\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null}, {\"type\": \"paragraph\", \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"Having a hypo while you’re asleep is known as nocturnal hypoglycaemia. It’s more common in people who treat diabetes with insulin.\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null, \"textStyle\": \"\", \"textFormat\": 0}, {\"type\": \"paragraph\", \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"Although some people find their sleep is disturbed when they experience nocturnal hypoglycaemia, you may only notice the symptoms when you wake up in the morning.\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null, \"textStyle\": \"\", \"textFormat\": 0}, {\"type\": \"paragraph\", \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"The symptoms of nocturnal hypoglycaemia can include:\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null, \"textStyle\": \"\", \"textFormat\": 0}, {\"tag\": \"ul\", \"type\": \"list\", \"start\": 1, \"format\": \"\", \"indent\": 0, \"version\": 1, \"children\": [{\"type\": \"listitem\", \"value\": 1, \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"headache – often likened to having a hangover\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null}, {\"type\": \"listitem\", \"value\": 2, \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"feeling unusually tired in the morning\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null}, {\"type\": \"listitem\", \"value\": 3, \"format\": \"start\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"damp sheets or clothing from sweating\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null}], \"listType\": \"bullet\", \"direction\": null}], \"direction\": null}}","prevention":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"tag":"h2","type":"heading","format":"start","indent":0,"version":1,"children":[{"mode":"normal","text":"Preventing hypoglycaemia","type":"text","style":"font-size: 18px;","detail":0,"format":0,"version":1}],"direction":null},{"type":"paragraph","format":"start","indent":0,"version":1,"children":[{"mode":"normal","text":"If you have diabetes, sticking to your medication plan and eating regular meals can help prevent hypoglycaemia.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null,"textStyle":"","textFormat":0},{"type":"paragraph","format":"start","indent":0,"version":1,"children":[{"mode":"normal","text":"It’s also important to monitor your blood glucose levels.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null,"textStyle":"","textFormat":0},{"tag":"h2","type":"heading","format":"start","indent":0,"version":1,"children":[{"mode":"normal","text":"Monitoring blood glucose","type":"text","style":"font-size: 17px;","detail":0,"format":0,"version":1}],"direction":null},{"type":"paragraph","format":"start","indent":0,"version":1,"children":[{"mode":"normal","text":"Regularly monitoring your blood glucose levels can help you keep your blood glucose as normal and stable as possible, and will help you spot the signs and symptoms of hypoglycaemia quickly.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null,"textStyle":"","textFormat":0},{"type":"paragraph","format":"start","indent":0,"version":1,"children":[{"mode":"normal","text":"Your blood glucose level can vary throughout the day, so you may need to check it several times a day, depending on the treatment you’re taking.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null,"textStyle":"","textFormat":0},{"type":"paragraph","format":"start","indent":0,"version":1,"children":[{"mode":"normal","text":"You can monitor your blood glucose levels using a blood glucose meter, a small device that measures the concentration of glucose in your blood.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null,"textStyle":"","textFormat":0},{"type":"paragraph","format":"start","indent":0,"version":1,"children":[{"mode":"normal","text":"Read more about living with type 1 diabetes and living with type 2 diabetes","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null,"textStyle":"","textFormat":0},{"tag":"h2","type":"heading","format":"start","indent":0,"version":1,"children":[{"mode":"normal","text":"Food and alcohol","type":"text","style":"font-size: 17px;","detail":0,"format":0,"version":1}],"direction":null},{"type":"paragraph","format":"start","indent":0,"version":1,"children":[{"mode":"normal","text":"If you have diabetes, strenuous physical activity can lead to hypoglycaemia. Eating extra carbohydrate-based foods before and during exercise can help reduce the chances of this happening.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null,"textStyle":"","textFormat":0},{"type":"paragraph","format":"start","indent":0,"version":1,"children":[{"mode":"normal","text":"If you’re taking insulin, your doctor may advise you to lower your dose before you do strenuous physical activity.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null,"textStyle":"","textFormat":0},{"type":"paragraph","format":"start","indent":0,"version":1,"children":[{"mode":"normal","text":"Alcohol can also affect your body’s ability to release glucose. If you have type 1 diabetes, it’s recommended that you drink no more than 2 to 3 units of alcohol a day and eat a snack after drinking alcohol.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null,"textStyle":"","textFormat":0},{"tag":"h2","type":"heading","format":"start","indent":0,"version":1,"children":[{"mode":"normal","text":"Spotting the signs","type":"text","style":"font-size: 17px;","detail":0,"format":0,"version":1}],"direction":null},{"type":"paragraph","format":"start","indent":0,"version":1,"children":[{"mode":"normal","text":"As hypoglycaemia can develop suddenly, it’s important to be aware of the symptoms of hypoglycaemia so you can treat it quickly. Tell your family and friends about the signs to look out for and let them know how to treat it.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null,"textStyle":"","textFormat":0},{"type":"paragraph","format":"start","indent":0,"version":1,"children":[{"mode":"normal","text":"People with diabetes are advised to carry a form of identification with them that states their condition so they can be helped quickly and efficiently.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null,"textStyle":"","textFormat":0},{"tag":"h2","type":"heading","format":"start","indent":0,"version":1,"children":[{"mode":"normal","text":"Keep treatment with you","type":"text","style":"font-size: 17px;","detail":0,"format":0,"version":1}],"direction":null},{"type":"paragraph","format":"start","indent":0,"version":1,"children":[{"mode":"normal","text":"If you’re at risk of hypoglycaemia, you should carry sugary food and drink with you at all times to treat mild cases as soon as possible.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null,"textStyle":"","textFormat":0},{"type":"paragraph","format":"start","indent":0,"version":1,"children":[{"mode":"normal","text":"If you have diabetes, particularly type 1 diabetes, your doctor may recommend medications such as glucose gel to carry with you. This can be used to treat hypoglycaemia that doesn’t respond to normal treatment.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null,"textStyle":"","textFormat":0},{"type":"paragraph","format":"start","indent":0,"version":1,"children":[{"mode":"normal","text":"If you’re being treated with insulin, you’ll usually be given a kit that contains an injection of a medication called glucagon. Family members or your carer can be trained to carry out the injection, which should be used if you lose consciousness because of severe hypoglycaemia.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null,"textStyle":"","textFormat":0},{"tag":"h2","type":"heading","format":"start","indent":0,"version":1,"children":[{"mode":"normal","text":"Preventing hypoglycaemia at night","type":"text","style":"font-size: 18px;","detail":0,"format":0,"version":1}],"direction":null},{"type":"paragraph","format":"start","indent":0,"version":1,"children":[{"mode":"normal","text":"It’s important to avoid recurrent hypoglycaemia during the night (nocturnal hypoglycaemia) as it can reduce the early symptoms of daytime episodes.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null,"textStyle":"","textFormat":0},{"type":"paragraph","format":"start","indent":0,"version":1,"children":[{"mode":"normal","text":"If you experience nocturnal hypoglycaemia, you can try:","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null,"textStyle":"","textFormat":0},{"tag":"ul","type":"list","start":1,"format":"","indent":0,"version":1,"children":[{"type":"listitem","value":1,"format":"start","indent":0,"version":1,"children":[{"mode":"normal","text":"keeping something sugary by your bedside","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null},{"type":"listitem","value":2,"format":"start","indent":0,"version":1,"children":[{"mode":"normal","text":"having a snack before bedtime, such as biscuits and milk","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null},{"type":"listitem","value":3,"format":"start","indent":0,"version":1,"children":[{"mode":"normal","text":"checking your blood glucose levels between 3am and 4am, when hypoglycaemia is most likely to occur","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null}],"listType":"bullet","direction":null},{"tag":"h2","type":"heading","format":"start","indent":0,"version":1,"children":[{"mode":"normal","text":"Hypoglycaemia and driving","type":"text","style":"font-size: 17px;","detail":0,"format":0,"version":1}],"direction":null},{"type":"paragraph","format":"start","indent":0,"version":1,"children":[{"mode":"normal","text":"As hypoglycaemia can cause confusion, drowsiness, or even unconsciousness, this can present a significant risk to you or other road users.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null,"textStyle":"","textFormat":0},{"type":"paragraph","format":"start","indent":0,"version":1,"children":[{"mode":"normal","text":"If you have diabetes that requires treatment with insulin, you must:","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null,"textStyle":"","textFormat":0},{"tag":"ul","type":"list","start":1,"format":"","indent":0,"version":1,"children":[{"type":"listitem","value":1,"format":"start","indent":0,"version":1,"children":[{"mode":"normal","text":"inform the DVLA and your insurance company","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null},{"type":"listitem","value":2,"format":"start","indent":0,"version":1,"children":[{"mode":"normal","text":"test your blood sugar before driving and at regular intervals (at least every two hours) while driving","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null},{"type":"listitem","value":3,"format":"start","indent":0,"version":1,"children":[{"mode":"normal","text":"avoid driving if your blood glucose is low","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null},{"type":"listitem","value":4,"format":"start","indent":0,"version":1,"children":[{"mode":"normal","text":"avoid driving for 45 minutes after treating hypoglycaemia","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null},{"type":"listitem","value":5,"format":"start","indent":0,"version":1,"children":[{"mode":"normal","text":"carry rapid-acting carbohydrates with you in the vehicle at all times","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null}],"listType":"bullet","direction":null},{"type":"paragraph","format":"start","indent":0,"version":1,"children":[{"mode":"normal","text":"If you experience hypoglycaemia while driving, pull over and stop as soon as it’s safe to do so. Remove the keys from the ignition and get out of the driver’s seat before treating hypoglycaemia in the normal way.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null,"textStyle":"","textFormat":0},{"type":"paragraph","format":"start","indent":0,"version":1,"children":[{"mode":"normal","text":"If you have two or more episodes of hypoglycaemia that require assistance in a 12-month period, it’s a legal requirement to stop driving and inform the DVLA.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null,"textStyle":"","textFormat":0},{"type":"paragraph","format":"start","indent":0,"version":1,"children":[{"mode":"normal","text":"If you’re a group two driver (you hold a licence to drive buses, coaches or lorries), you’re legally required to stop driving group two vehicles immediately and inform the DVLA if you have a single episode of hypoglycaemia that requires assistance.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null,"textStyle":"","textFormat":0},{"type":"paragraph","format":"start","indent":0,"version":1,"children":[{"mode":"normal","text":"Inform your diabetes care team if you start having problems recognising hypoglycaemia or you start to have more regular episodes, even if there were warning symptoms and you were able to treat them without assistance.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null,"textStyle":"","textFormat":0}],"direction":null}},"contact_your_doctor":"{\"root\": {\"type\": \"root\", \"format\": \"\", \"indent\": 0, \"version\": 1, \"children\": [{\"type\": \"paragraph\", \"format\": \"\", \"indent\": 0, \"version\": 1, \"children\": [], \"direction\": null, \"textStyle\": \"\", \"textFormat\": 0}], \"direction\": null}}","more_information":"{\"root\": {\"type\": \"root\", \"format\": \"\", \"indent\": 0, \"version\": 1, \"children\": [{\"type\": \"paragraph\", \"format\": \"\", \"indent\": 0, \"version\": 1, \"children\": [], \"direction\": null, \"textStyle\": \"\", \"textFormat\": 0}], \"direction\": null}}","attribution":"{\"root\": {\"type\": \"root\", \"format\": \"\", \"indent\": 0, \"version\": 1, \"children\": [{\"type\": \"paragraph\", \"format\": \"\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"Source: \", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}, {\"rel\": \"noreferrer\", \"url\": \"https://www.nhsinform.scot/\", \"type\": \"link\", \"title\": null, \"format\": \"\", \"indent\": 0, \"target\": null, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"NHIS Inform\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null}], \"direction\": null, \"textStyle\": \"\", \"textFormat\": 0}, {\"type\": \"paragraph\", \"format\": \"\", \"indent\": 0, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"Source: \", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}, {\"rel\": \"noreferrer\", \"url\": \"https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/\", \"type\": \"link\", \"title\": null, \"format\": \"\", \"indent\": 0, \"target\": null, \"version\": 1, \"children\": [{\"mode\": \"normal\", \"text\": \"National Archives\", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null}, {\"mode\": \"normal\", \"text\": \"   \", \"type\": \"text\", \"style\": \"\", \"detail\": 0, \"format\": 0, \"version\": 1}], \"direction\": null, \"textStyle\": \"\", \"textFormat\": 0}], \"direction\": null}}","is_systemic":false,"search_vector":null,"specialist":"Endocrinologist ","created_at":"2026-04-25 21:13:39.052733","updated_at":"2026-04-25 21:13:39.052733","status":"published","is_featured":false,"featured_order":0,"featured_from":null,"featured_until":null,"view_count":0,"author_id":null,"reviewed_by":null,"reviewed_at":null,"is_pinned":false,"metadata":"{}"}]