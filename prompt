nt_id":"e3e2d933-8b1d-4bf5-a472-0bf3761ec7cb","path":"Muscleboneandjoint.Chestandribproblemsandconditions","level":1,"type":"condition"},{"idx":27,"id":"28cccf3c-b236-43ae-9cbb-742afe0dfcb3","name":"Leg and foot problems and conditions","slug":"leg-and-foot-problems-and-conditions","description":"Advice on how to manage leg and foot problems and when to contact your healthcare professional.","parent_id":"e3e2d933-8b1d-4bf5-a472-0bf3761ec7cb","path":"Muscleboneandjoint.Legandfootproblemsandconditions","level":1,"type":"condition"},{"idx":28,"id":"89b587ba-6308-4a17-97b5-0e366497ba75","name":"Neck and back problems and conditions","slug":"neck-and-back-problems-and-conditions","description":"Advice on how to manage neck and back problems and when to contact your healthcare professional.","parent_id":"e3e2d933-8b1d-4bf5-a472-0bf3761ec7cb","path":"Muscleboneandjoint.Neckandbackproblemsandconditions","level":1,"type":"condition"},{"idx":29,"id":"e4d47179-d41c-4045-8a6f-80a3e895a0d6","name":"Scoliosis","slug":"scoliosis","description":"Information and advice about scoliosis in adults and children","parent_id":"e3e2d933-8b1d-4bf5-a472-0bf3761ec7cb","path":"Muscleboneandjoint.Scoliosis","level":1,"type":"condition"},{"idx":30,"id":"5fd6fa4f-5934-4c2e-a004-94177277a501","name":"Nutritional","slug":"nutritional","description":"Information on obesity, malnutrition and iron deficiency anaemia.\n","parent_id":null,"path":"Nutritional","level":0,"type":"condition"},{"idx":31,"id":"4816fc19-4e56-4535-bbf5-c6295778507c","name":"Pregnancy and childbirth","slug":"pregnancy-and-childbirth","description":"Information on illnesses and conditions which could occur in pregnancy and childbirth, including ectopic pregnancy, miscarriage, and stillbirth.","parent_id":null,"path":"Pregnancyandchildbirth","level":0,"type":"condition"},{"idx":32,"id":"2fe71437-a9dc-4403-bede-253f2bfbbdd1","name":"After losing a baby","slug":"after-losing-a-baby","description":null,"parent_id":"4816fc19-4e56-4535-bbf5-c6295778507c","path":"Pregnancyandchildbirth.Afterlosingababy","level":1,"type":"condition"},{"idx":33,"id":"c1c229e6-5108-4e9d-8182-69867d756224","name":"During pregnancy","slug":"during-pregnancy","description":null,"parent_id":"4816fc19-4e56-4535-bbf5-c6295778507c","path":"Pregnancyandchildbirth.Duringpregnancy","level":1,"type":"condition"},{"idx":34,"id":"e514b752-e720-4e54-a355-d5044e3babd4","name":"Losing a baby","slug":"losing-a-baby","description":null,"parent_id":"4816fc19-4e56-4535-bbf5-c6295778507c","path":"Pregnancyandchildbirth.Losingababy","level":1,"type":"condition"},{"idx":35,"id":"752ebac7-d815-4949-b04e-017f80be96ce","name":"Rare conditions","slug":"rare-conditions","description":"Information on rare conditions and where to get support in Scotland.","parent_id":null,"path":"Rareconditions","level":0,"type":"condition"},{"idx":36,"id":"7efc8565-9ad8-42bb-a298-45bdd37cd036","name":"Sexual and Reproductive","slug":"sexual-and-reproductive","description":"Conditions related to sexual health and the reproductive system.","parent_id":null,"path":"SexualandReproductive","level":0,"type":"condition"},{"idx":37,"id":"97ed9acd-a5f5-4093-8070-848defed4812","name":"Skin","slug":"skin","description":"Information about skin including symptoms, conditions and treatment options.","parent_id":null,"path":"Skin","level":0,"type":"condition"},{"idx":38,"id":"5d8ab6e7-5405-471b-a9df-08844c908080","name":"Rashes, irritation and swelling","slug":"rashes-irritation-and-swelling","description":"Changes to the skin can appear suddenly or develop over time. This can include redness, swelling, itching, spots or bumps (hives). The causes and symptoms can vary, and treatment depends on what it is that’s triggering the reaction.","parent_id":"97ed9acd-a5f5-4093-8070-848defed4812","path":"Skin.Rashesirritationandswelling","level":1,"type":"condition"},{"idx":39,"id":"7a31a4ed-5667-4515-a4c2-8f019bbffb3c","name":"Skin conditions","slug":"skin-conditions","description":"Skin conditions can affect the skins appearance, comfort and can lead to changes over time. Symptoms, severity and flare-ups may vary from person-to-person. There are different treatment options to help manage symptoms, depending on the cause.","parent_id":"97ed9acd-a5f5-4093-8070-848defed4812","path":"Skin.Skinconditions","level":1,"type":"condition"},{"idx":40,"id":"07d4ddae-fec4-4ba2-8255-96eb96a4b048","name":"Skin injuries, bites and infections","slug":"skin-injuries-bites-and-infections","description":"The skin can be affected by cuts, burns, bites and infections. These can lead to symptoms like pain, swelling or changes in the skin’s appearance. The treatment and healing process will depend on the cause and severity.","parent_id":"97ed9acd-a5f5-4093-8070-848defed4812","path":"Skin.Skininjuriesbitesandinfections","level":1,"type":"condition"},{"idx":41,"id":"89b95d01-620d-4c32-a163-c17570e18ff6","name":"Sun safety and skin cancer","slug":"sun-safety-and-skin-cancer","description":"Sun exposure can affect the skin in different ways, from short-term sensitivity to long-term changes. Understanding how to protect your skin from the sun will help to support skin health.","parent_id":"97ed9acd-a5f5-4093-8070-848defed4812","path":"Skin.Sunsafetyandskincancer","level":1,"type":"condition"},{"idx":42,"id":"f84ab046-ca2b-4a94-861a-40cc2cb6b8d8","name":"Stomach, Liver and Gastrointestinal","slug":"stomach-liver-and-gastrointestinal","description":"Conditions affecting the digestive system.","parent_id":null,"path":"StomachLiverandGastrointestinal","level":0,"type":"condition"},{"idx":43,"id":"cdeb95d4-1f37-42b8-85ca-7d4c6d3b9129","name":"Coeliac disease","slug":"coeliac-disease","description":"Coeliac disease is a condition where the body’s immune system damages the lining of the small bowel when gluten is eaten. Learn about the symptoms and treatments of this condition.","parent_id":"f84ab046-ca2b-4a94-861a-40cc2cb6b8d8","path":"StomachLiverandGastrointestinal.Coeliacdisease","level":1,"type":"condition"}]
